# Local hosted-persistence development defaults. Never commit real values.
SENTINEL_ENV=development
SENTINEL_DATABASE_URL=sqlite:///data/sentinel_hosted_development.db
SENTINEL_CREDENTIAL_KEYS=<fernet-key-from-your-secret-manager>
SENTINEL_DB_POOL_SIZE=5
SENTINEL_DB_MAX_OVERFLOW=10
SENTINEL_DB_POOL_TIMEOUT_SECONDS=10
SENTINEL_DB_SLOW_QUERY_MS=250
